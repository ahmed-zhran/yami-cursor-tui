{
  "name": "yami-cursor-tui",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal chat UI for driving a Cursor agent session",
  "type": "module",
  "bin": {
    "yami": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "prepublishOnly": "pnpm build",
    "prepare": "pnpm build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@cursor/sdk": "^1.3.1",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "dependency-cruiser": "^18.7.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
